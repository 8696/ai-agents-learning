# apps/ 唯一配置（不要放仓库根目录）。复制：cp .env.example .env
# Demo 只认「选用」两行；各家 Key / URL 由 apps/llm.ts 按 LLM_PROVIDER 去取。
# 说明：docs/02-怎么用.md §1.2.1
#
# 一家提供商 = 一把 Key + 协议 A（OpenAI 兼容）+ 协议 B（Anthropic 兼容，同 Key 换 URL）

# ── 选用（换线路只改这里）────────────────────────────────────────
# LLM_PROVIDER  minimax | zhipu | custom
# LLM_MODEL     留空 = 用该提供商默认模型；填写则协议 A/B 都用这个 id
LLM_PROVIDER=minimax
LLM_MODEL=
# LLM_ANTHROPIC_MAX_TOKENS=1024

# ── MiniMax（LLM_PROVIDER=minimax）────────────────────────────────
# 控制台：https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_ANTHROPIC_MODEL=MiniMax-M3

# ── 智谱（LLM_PROVIDER=zhipu）─────────────────────────────────────
# 控制台：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4-flash
ZHIPU_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ZHIPU_ANTHROPIC_MODEL=glm-4-flash

# ── 自定义网关（LLM_PROVIDER=custom）──────────────────────────────
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://llm.goaichat.top/v1
CUSTOM_MODEL=
CUSTOM_ANTHROPIC_BASE_URL=https://llm.goaichat.top
CUSTOM_ANTHROPIC_MODEL=

# 不要在本文件写 PORT（会把所有 HTTP Demo 拧到同一个口）。
# 单次覆盖：PORT=50201 yarn app:02-01-streaming-sse
